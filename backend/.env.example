# Server
NODE_ENV=development
PORT=4000

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vendora?schema=public

# Authentication
# Generate strong random values in production, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
GUEST_CART_TTL_DAYS=90

# Refresh-token cookie. SameSite=lax is fine for localhost:3000 <-> :4000 in
# dev (same site, different port); revisit if frontend/backend end up on
# genuinely different sites in production.
COOKIE_SAME_SITE=lax

# Cloudinary (not integrated yet)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (provider not finalized yet)
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
