// Vendora — Phase 1 domain schema.
// See docs/architecture/database-architecture.md for the full design write-up
// (ER diagram, business rules, and the reasoning behind onDelete choices).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Authentication
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// A user is a buyer by default (role USER). Seller capability is NOT a role —
// it's granted by having an approved Store (see SellerApplication/Store below).
// This lets an approved seller keep buying like any other user.
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]

  sellerApplication          SellerApplication?  @relation("SellerApplicationApplicant")
  reviewedSellerApplications SellerApplication[] @relation("SellerApplicationReviewer")

  store Store?

  reviewedProducts Product[] @relation("ProductReviewer")

  cart          Cart?
  wishlistItems WishlistItem[]

  orders Order[] @relation("OrderBuyer")

  refundsRequested Refund[] @relation("RefundRequester")
  refundsReviewed  Refund[] @relation("RefundReviewer")

  reviews Review[]

  productReportsFiled    ProductReport[] @relation("ProductReportReporter")
  productReportsResolved ProductReport[] @relation("ProductReportResolver")

  notifications       Notification[]
  digitalEntitlements DigitalEntitlement[]
  auditLogs           AuditLog[]           @relation("AuditLogActor")
  announcementUpdates Announcement[]       @relation("AnnouncementUpdatedBy")

  @@index([role])
  @@index([status])
}

// Refresh tokens (and, by extension, login sessions) are stored as hashes —
// never the raw token — so a leaked database dump doesn't yield usable
// credentials. Rotation is supported via replacedByTokenHash.
model RefreshToken {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Phase 2 addition: forgot/reset-password support. Phase 1 only modeled
// session tokens (RefreshToken); a single-use, expiring reset token is a
// genuinely separate concern (different lifetime, single-use, no rotation),
// so it gets its own small table rather than overloading RefreshToken.
// Stores a hash of the token, never the raw value, same reasoning as
// RefreshToken.tokenHash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String   @default("Nigeria")
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sellers & Stores
// ---------------------------------------------------------------------------

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// One application per user — resubmission edits and re-submits the same row
// (status goes back to PENDING) instead of creating a new record.
model SellerApplication {
  id                   String                  @id @default(cuid())
  userId               String                  @unique
  storeName            String
  storeDescription     String
  storeLogoUrl         String?
  storeBannerUrl       String?
  businessCategory     String
  phone                String
  email                String
  location             String
  businessRegistration String?
  status               SellerApplicationStatus @default(PENDING)
  rejectionReason      String?
  submittedAt          DateTime                @default(now())
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  applicant User  @relation("SellerApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)
  reviewer  User? @relation("SellerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// Created when a SellerApplication is approved. If suspended, the store and
// its products become unavailable publicly, but historical orders and digital
// entitlements tied to it remain fully intact (see Product/Order onDelete
// strategy below) — nothing here gets deleted on suspension.
model Store {
  id                   String      @id @default(cuid())
  sellerId             String      @unique
  name                 String
  slug                 String      @unique
  description          String
  logoUrl              String?
  bannerUrl            String?
  businessCategory     String
  phone                String
  email                String
  location             String
  businessRegistration String?
  status               StoreStatus @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  seller   User      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  products Product[]

  sellerOrders SellerOrder[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

// Flat (no parent/child) — V1 doesn't need hierarchical categories.
// Managed directly in the database/admin tooling, not a public API.
model Category {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products Product[]
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ShippingType {
  FREE
  FIXED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// V1 supports simple products only (no variants). Physical vs digital fields
// (stockQuantity/shippingType/shippingFee) are only meaningful for PHYSICAL —
// enforced at the application/validation layer, not the database, since Prisma
// can't conditionally require columns based on another column's value.
model Product {
  id              String        @id @default(cuid())
  storeId         String
  categoryId      String
  name            String
  slug            String        @unique
  description     String
  type            ProductType
  price           Decimal       @db.Decimal(12, 2)
  stockQuantity   Int?
  shippingType    ShippingType?
  shippingFee     Decimal?      @db.Decimal(12, 2)
  status          ProductStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewer User?    @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  images            ProductImage[]
  digitalVersions   DigitalProductVersion[]
  views             ProductView[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reports           ProductReport[]
  stockReservations StockReservation[]

  // Historical records — a Product can never be hard-deleted once referenced.
  orderItems          OrderItem[]
  digitalEntitlements DigitalEntitlement[]
  reviews             Review[]

  @@index([status])
  @@index([categoryId])
  @@index([storeId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Each row is one uploaded version of a digital product's file. The file
// itself lives in private storage (Cloudinary or equivalent) — `fileKey` is a
// storage reference, never a permanently public URL. "Latest version" is the
// row with the highest `version` for a given product; DigitalEntitlement
// resolves access dynamically instead of duplicating a row per version.
model DigitalProductVersion {
  id        String   @id @default(cuid())
  productId String
  version   Int
  fileKey   String
  fileType  String
  fileSize  BigInt
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@index([productId])
}

// Distinguishes authenticated views (userId set) from anonymous ones
// (visitorId set instead) for later seller analytics (Phase 12).
model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  visitorId String?
  viewedAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
}

// ---------------------------------------------------------------------------
// Cart & Wishlist
// ---------------------------------------------------------------------------

// One cart per user, holding items from any number of stores at once. The
// backend revalidates price/stock/status against the live Product at
// checkout — nothing here is snapshotted.
//
// Overhaul Phase 3: a Cart now belongs to exactly one of a registered user
// (`userId`) or an anonymous browser (`guestToken`, an unguessable
// server-generated value handed back in an HttpOnly cookie) — never both,
// never neither. Enforced in cart.middleware.ts's resolveCart(), not a DB
// constraint (Prisma has no partial/conditional check constraint syntax —
// same limitation already noted on ProductReport's partial unique index).
// A guest cart is merged into the user's own Cart and deleted at
// login/register time (auth.service.ts), so an authenticated user's Cart
// always has `userId` set and `guestToken` null.
model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  guestToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Orders (multi-vendor: one Order -> many SellerOrders -> many OrderItems)
// ---------------------------------------------------------------------------

// Aggregate status across all of a buyer's SellerOrders. PARTIALLY_* states
// exist because one seller can ship their portion while another is still
// processing theirs — the parent Order must reflect that mixed state.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_PROCESSING
  PARTIALLY_SHIPPED
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

// A single seller's slice of a multi-vendor order. Its own, simpler lifecycle
// — no PARTIALLY_* states needed here since a SellerOrder is one seller's
// items moving through fulfillment together.
enum SellerOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// The buyer's overall checkout. Never hard-deleted — buyerId and
// shippingAddressId are both Restrict so neither the buyer nor the address
// they shipped to can be removed while this order exists.
model Order {
  id                String      @id @default(cuid())
  buyerId           String
  status            OrderStatus @default(PENDING_PAYMENT)
  totalAmount       Decimal     @db.Decimal(12, 2)
  currency          String      @default("NGN")
  shippingAddressId String?
  placedAt          DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  buyer           User     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  shippingAddress Address? @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)

  sellerOrders      SellerOrder[]
  payment           Payment?
  refunds           Refund[]
  stockReservations StockReservation[]

  @@index([buyerId])
  @@index([status])
}

// One seller's portion of an Order. Carries its own shipping fee since
// different sellers in the same checkout can charge different shipping.
model SellerOrder {
  id          String            @id @default(cuid())
  orderId     String
  storeId     String
  status      SellerOrderStatus @default(PENDING)
  subtotal    Decimal           @db.Decimal(12, 2)
  shippingFee Decimal           @default(0) @db.Decimal(12, 2)
  total       Decimal           @db.Decimal(12, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  items   OrderItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([storeId])
  @@index([status])
}

// Snapshots the product as it was at purchase time. Product edits (name,
// price, description) after the fact must never change what a historical
// order shows — productId is kept (Restrict) for traceability, but every
// display field is duplicated here rather than read live from Product.
model OrderItem {
  id                  String      @id @default(cuid())
  sellerOrderId       String
  productId           String
  productNameSnapshot String
  priceSnapshot       Decimal     @db.Decimal(12, 2)
  quantity            Int
  productTypeSnapshot ProductType
  shippingFeeSnapshot Decimal?    @db.Decimal(12, 2)
  storeNameSnapshot   String
  createdAt           DateTime    @default(now())

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  refunds             Refund[]
  digitalEntitlements DigitalEntitlement[]
  review              Review?

  @@index([sellerOrderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Stock Reservations
// ---------------------------------------------------------------------------

enum StockReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

// Reserves stock during checkout so two buyers can't oversell the same
// limited-stock product. orderId is nullable because a reservation is created
// the moment checkout starts, before an Order necessarily exists yet.
model StockReservation {
  id        String                 @id @default(cuid())
  productId String
  orderId   String?
  quantity  Int
  status    StockReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime               @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// One Payment per Order, representing its current settled state. Provider is
// a plain string (not an enum) precisely so a new payment provider can be
// introduced later without a schema/migration change.
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String
  providerReference String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  @@index([status])
}

// Every attempt to charge, including failures — kept separately from Payment
// so a failed retry doesn't overwrite the record of what actually happened.
model PaymentAttempt {
  id                String               @id @default(cuid())
  paymentId         String
  provider          String
  providerReference String?
  amount            Decimal              @db.Decimal(12, 2)
  status            PaymentAttemptStatus @default(PENDING)
  rawResponse       Json?
  attemptedAt       DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Refunds
// ---------------------------------------------------------------------------

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

// Scope is one of orderId / sellerOrderId / orderItemId (enforced at the
// application layer — a multi-vendor order is not always refunded as a
// whole). Provider refund reference is separate from Vendora's own ids so it
// can be reconciled against the payment provider's dashboard/webhooks.
model Refund {
  id                      String       @id @default(cuid())
  orderId                 String?
  sellerOrderId           String?
  orderItemId             String?
  amount                  Decimal      @db.Decimal(12, 2)
  reason                  String
  status                  RefundStatus @default(REQUESTED)
  requestedById           String
  reviewedById            String?
  reviewedAt              DateTime?
  providerRefundReference String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  requestedBy User  @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Digital Entitlements
// ---------------------------------------------------------------------------

// Proof of "this user may access this digital product". One row per
// user+product regardless of how many versions the seller later uploads —
// access always resolves to the current latest DigitalProductVersion.
model DigitalEntitlement {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  orderItemId String
  grantedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

// Tied to the specific OrderItem that qualifies the reviewer as a verified
// buyer (order must be delivered/completed — enforced at the service layer).
// @@unique on orderItemId means one review per qualifying purchase line.
model Review {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  orderItemId String   @unique
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Product Reports
// ---------------------------------------------------------------------------

enum ProductReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// "One active report per user per product" is enforced with a partial unique
// index added by hand in the migration (see
// prisma/migrations/*_product_report_partial_unique/migration.sql) — Prisma's
// schema syntax alone can't express a WHERE-conditional unique constraint.
model ProductReport {
  id             String              @id @default(cuid())
  reporterId     String
  productId      String
  reason         String
  description    String?
  status         ProductReportStatus @default(PENDING)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter   User    @relation("ProductReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("ProductReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reporterId, productId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  ORDER_PLACED
  PAYMENT_SUCCESS
  ORDER_SHIPPED
  ORDER_DELIVERED
  REFUND_UPDATE
  NEW_REVIEW
  GENERIC
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit Logs
// ---------------------------------------------------------------------------

// actorId is nullable + SetNull so the audit trail survives even if the admin
// account that performed the action is later removed.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Site Content
// ---------------------------------------------------------------------------

// Deliberately a fixed-id singleton (always read/write id=1) rather than an
// `enabled` flag among potentially-many rows — Part 2 of the overhaul plan:
// there's only ever one active announcement message, no "which one" query
// needed.
model Announcement {
  id          Int      @id
  message     String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("AnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}
