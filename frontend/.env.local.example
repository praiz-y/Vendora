# URL of the Vendora backend API. Server-only: the browser calls /api/* on
# this app's own origin and next.config.ts rewrites it here, so auth cookies
# stay first-party. Read at build time on Vercel — redeploy after changing it.
BACKEND_URL=http://localhost:4000

# Public URL this frontend is served from — used for metadataBase, canonical
# URLs, sitemap.xml, and robots.txt. Must be the real production domain
# (with https://) once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
