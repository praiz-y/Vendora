# URL of the Vendora backend API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL this frontend is served from — used for metadataBase, canonical
# URLs, sitemap.xml, and robots.txt. Must be the real production domain
# (with https://) once deployed; it is NOT the same as NEXT_PUBLIC_API_URL,
# since frontend and backend can live on different origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
